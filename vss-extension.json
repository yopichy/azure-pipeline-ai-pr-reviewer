{
    "manifestVersion": 1,
    "id": "AIPrReviewer",
    "name": "AI PR Reviewer",
    "version": "2.0.15",
    "publisher": "inskyid",
    "galleryFlags": [
        "Public",
        "Preview"
    ],
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],
    "description": "AI PR Reviewer - Automated Pull Request reviews using GPT models",
    "categories": [
        "Azure Pipelines"
    ],
    "icons": {
        "default": "images/icon.png"
    },
    "tags": [
        "OpenAI",
        "GPT",
        "pullRequest",
        "review",
		"prompt"
    ],
    "files": [
        {
            "path": "AiPrReviewer"
        }
    ],
    "repository": {
        "type": "git",
        "uri": "https://github.com/yopichy/azure-pipeline-ai-pr-reviewer"
    },
    "content": {
        "details": {
            "path": "overview.md"
        }
    },
    "contributions": [
        {
            "id": "AIPrReviewer",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "AiPrReviewer"
            }
        }
    ]
}